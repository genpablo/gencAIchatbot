# Copy to .env and edit.

DATABASE_URL=postgresql://rag:rag@127.0.0.1:5432/kbeauty
# Docker host port; keep this and the port in DATABASE_URL in sync.
POSTGRES_PORT=5432

# ollama = local test | bedrock = Amazon Bedrock | foundry = Microsoft Foundry | mock = no model (CI)
# openai = any OpenAI-compatible service | openrouter = the same, with OpenRouter's URL as the default
LLM_PROVIDER=ollama
# Ask reasoning models (DeepSeek Flash, GPT Luna / GPT-5+, Claude Sonnet 5.5, Qwen3) not to think.
# Thinking tokens are billed as output and slow answers; set false only to compare quality.
DISABLE_THINKING=true

# --- Embeddings (any model; independent of the chat model) ---
# Service: empty = same as LLM_PROVIDER | ollama | openai | openrouter | foundry | bedrock | mock
#          | your.module:ClassName (a class with embed(texts, kind) -> list of vectors)
EMBED_PROVIDER=
EMBED_MODEL=                # empty = that service's *_EMBED_* setting below
# Only for openai/openrouter embeddings from another service than chat (the chat key is not sent there):
EMBED_BASE_URL=             # e.g. https://api.openai.com/v1, http://localhost:8080/v1 (vLLM/TEI)
EMBED_API_KEY=
# Every model must output this size (longer Matryoshka vectors, e.g. Qwen3-Embedding-8B, are shortened).
# Changing it needs a new, empty database (python -m app.ingest --init).
EMBED_DIM=1024
EMBED_TRUNCATE=auto         # auto = shorten only models trained for it | true | false
# Prefixes are set automatically for Qwen3-Embedding, E5, Nomic and mxbai. Uncomment to override:
# EMBED_QUERY_PREFIX="Instruct: Find products for this customer\nQuery:"
# EMBED_DOCUMENT_PREFIX=
# After changing the embedding model: python -m app.ingest --embed

# --- Local (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_PARSE_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b   # ollama pull qwen3-embedding:0.6b (1024-d); or bge-m3
OLLAMA_DISABLE_THINKING=true
OLLAMA_TIMEOUT_S=300

# --- Amazon Bedrock (production) ---
# Check exact ids / inference profiles: aws bedrock list-inference-profiles --region ap-northeast-2
AWS_REGION=ap-northeast-2
BEDROCK_CHAT_MODEL=anthropic.claude-sonnet-5
BEDROCK_PARSE_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=cohere.embed-v4:0
# Alternatives: qwen.qwen3-235b-a22b-2507-v1:0, deepseek.v3.2, amazon.titan-embed-text-v2:0

# --- Microsoft Foundry (LLM_PROVIDER=foundry) ---
# Foundry portal > your project > Models + endpoints. Use DEPLOYMENT names (case-sensitive), not model names.
# Works with models served on the OpenAI-compatible endpoint: GPT-4.1 / GPT-5 family, DeepSeek, Llama, Grok, ...
FOUNDRY_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1/
FOUNDRY_AUTH=key            # key = API key below; entra = Microsoft Entra ID (az login / managed identity; pip install azure-identity)
FOUNDRY_API_KEY=
FOUNDRY_CHAT_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_PARSE_DEPLOYMENT=   # optional cheaper/faster deployment for reading notes and descriptions
FOUNDRY_EMBED_DEPLOYMENT=text-embedding-3-large   # OpenAI model, shortened to EMBED_DIM
FOUNDRY_TIMEOUT_S=120

# --- Third-party providers (LLM_PROVIDER=openai or openrouter) ---
# Any service with an OpenAI-compatible API: OpenRouter, OpenAI, Together, Groq, vLLM, LM Studio, ...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                # leave empty for local servers without a key
LLM_CHAT_MODEL=qwen/qwen3.7-flash   # Qwen3.7 Flash, the default on OpenRouter; or openai/gpt-4.1-mini
LLM_PARSE_MODEL=            # optional cheaper/faster model for reading notes and descriptions
LLM_EMBED_MODEL=qwen/qwen3-embedding-8b      # or openai/text-embedding-3-large
LLM_TIMEOUT_S=120

# --- Retrieval (ranking weights are set in the admin portal at /admin) ---
RETRIEVE_K=30
SHORTLIST_SIZE=20
# Product descriptions the AI reads at the same time during an Excel import (lower it if the provider rate-limits)
IMPORT_WORKERS=6

# --- Admin portal (/admin). Leave ADMIN_PASSWORD empty to disable the portal. ---
# Generate a SECRET_KEY with:  python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSWORD=change-me
SECRET_KEY=replace-with-a-long-random-string
ADMIN_SESSION_HOURS=12

# --- Staff chat app (http://localhost:8000/) ---
STAFF_SESSION_DAYS=30       # how long phones stay signed in
BRAND_NAME=Gen C Beauty
BRAND_LOGO_URL=https://cdn11.bigcommerce.com/s-kzkmuqjqk9/images/stencil/original/download1_1659212301__04676.original.png

# --- Customer assistant (/shop online, /store in store; no login, set up in Admin > Customer assistant) ---
PUBLIC_CHAT_PER_MINUTE=8     # messages per visitor; every message may call the AI model
PUBLIC_CHAT_PER_HOUR=60
# Sites that may show /shop in a frame (the BigCommerce chat bubble, /widget.js); space-separated
SHOP_EMBED_ORIGINS=https://gencbeauty.com https://www.gencbeauty.com https://*.mybigcommerce.com

# Currency of the price / cost columns
CURRENCY=USD
# Ambiguous dates in imported files (03/04/2027): MDY = month/day/year, DMY = day/month/year
DATE_ORDER=MDY
